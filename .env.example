APP_NAME=Pakistani News Stream Intelligence
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://news_intelligence:CHANGE_ME@127.0.0.1:5432/pak_news_intelligence
ADMIN_PASSWORD=CHANGE_ME
TIMEZONE=Asia/Karachi
LOG_LEVEL=INFO

# Phase 2 stream ingestion. PostgreSQL setup is not required for the probe.
GEO_NEWS_URL=https://www.youtube.com/@geonews/live
STREAM_CAPTURE_FPS=2.0
STREAM_TARGET_HEIGHT=1080
STREAM_QUEUE_CAPACITY=32
FFMPEG_PATH=ffmpeg
# Optional only when YouTube requires a signed-in browser session, e.g. chrome or firefox.
YTDLP_COOKIES_FROM_BROWSER=

# Phase 3 OCR — CPU-only
OCR_CPU_THREADS=4
OCR_DETECTION_THRESHOLD=0.25
OCR_DETECTION_BOX_THRESHOLD=0.45
OCR_DETECTION_UNCLIP_RATIO=1.8
OCR_MINIMUM_CANDIDATE_CONFIDENCE=0.35
OCR_HIGH_CONFIDENCE_THRESHOLD=0.95
OCR_FALLBACK_TRIGGER_THRESHOLD=0.95
OCR_FALLBACK_AUDIT_INTERVAL_FRAMES=10
OCR_FRAME_DUPLICATE_THRESHOLD=0.97
# Optional local fine-tuned model directories. Leave blank for official models.
OCR_CUSTOM_DETECTION_MODEL_DIR=
OCR_CUSTOM_URDU_MODEL_DIR=
OCR_CUSTOM_ENGLISH_MODEL_DIR=

# Phase 4 exact rolling sentence reconstruction
SEGMENTATION_ROW_TOLERANCE_RATIO=0.025
SEGMENTATION_TRACK_TOLERANCE_RATIO=0.045
SEGMENTATION_STABLE_HEADLINE_FRAMES=2
SEGMENTATION_STALE_TRACK_FRAMES=6
SEGMENTATION_MINIMUM_UNIT_CHARACTERS=8
SEGMENTATION_MINIMUM_UNIT_WORDS=3
SEGMENTATION_MAXIMUM_PENDING_CHARACTERS=1200
# Fixed policy: no fuzzy overlap, typo variants, or autocorrection.
KEYWORD_MATCH_POLICY=exact_normalized_phrase_only

# Phase 5 keyword matching
KEYWORD_CACHE_REFRESH_SECONDS=60
KEYWORD_BUS_CAPACITY=128
KEYWORD_BUS_PUBLISH_TIMEOUT_SECONDS=5

# Phase 6 canonical-story deduplication — CPU-only and benchmark-gated
DEDUP_EMBEDDING_MODEL=intfloat/multilingual-e5-small
DEDUP_EMBEDDING_REVISION=fd1525a9fd15316a2d503bf26ab031a61d056e98
DEDUP_EMBEDDING_DIMENSIONS=384
DEDUP_SAME_DAY_AUTO_MERGE=0.93
DEDUP_CROSS_CHANNEL_WINDOW_MERGE=0.90
DEDUP_CROSS_LANGUAGE_AUTO_MERGE=0.94
DEDUP_REVIEW_THRESHOLD=0.84
DEDUP_MIN_LEXICAL_OVERLAP=0.24
DEDUP_HIGH_SEMANTIC_BYPASS=0.965
DEDUP_CROSS_CHANNEL_WINDOW_MINUTES=30
DEDUP_CANDIDATE_LIMIT=5000
DEDUP_BUS_CAPACITY=128
DEDUP_BUS_PUBLISH_TIMEOUT_SECONDS=5


# Phase 7 complete-sentence opposite-language translation
TRANSLATION_MODEL_ROOT=models/translation
TRANSLATION_COMPUTE_TYPE=int8
TRANSLATION_INTER_THREADS=2
TRANSLATION_INTRA_THREADS=2
TRANSLATION_BEAM_SIZE=2
TRANSLATION_RETRY_BEAM_SIZE=4
TRANSLATION_MAX_BATCH_SIZE=8
TRANSLATION_MICRO_BATCH_WAIT_MS=35
TRANSLATION_QUEUE_CAPACITY=256
TRANSLATION_PUBLISH_TIMEOUT_SECONDS=5
TRANSLATION_CACHE_CAPACITY=10000
TRANSLATION_MAX_SOURCE_CHARACTERS=900
LIVE_FEED_WINDOW_MINUTES=30

# Phase 8 PostgreSQL persistence and outage recovery
PERSISTENCE_SPOOL_ROOT=data/spool/persistence
PERSISTENCE_SPOOL_MAX_BYTES=2147483648
PERSISTENCE_SPOOL_MAX_ATTEMPTS=50
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=12
JOB_LEASE_SECONDS=120
RAW_OCR_RETENTION_DAYS=7


# Phase 9 additive bilingual summaries
SUMMARY_INTERVAL_SECONDS=300
SUMMARY_DUPLICATE_THRESHOLD=0.94
SUMMARY_REVIEW_THRESHOLD=0.86
SUMMARY_MIN_LEXICAL_OVERLAP=0.20
SUMMARY_MAX_STORIES_PER_CATEGORY_RUN=5000
SUMMARY_JOB_DRAIN_LIMIT=5000
SUMMARY_PREVIOUS_DAY_GRACE_MINUTES=30
SUMMARY_EMBEDDING_MODEL=intfloat/multilingual-e5-small
SUMMARY_EMBEDDING_REVISION=fd1525a9fd15316a2d503bf26ab031a61d056e98
SUMMARY_EMBEDDING_DIMENSIONS=384
SUMMARY_REQUIRE_COMPLETE_BILINGUAL_FACT=true
SUMMARY_ABSTRACTIVE_DIGEST_ENABLED=false

# Phase 10 REST/WebSocket API
# Set these to long random values before exposing the app beyond localhost.
API_CURSOR_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_CURSOR_SECRET
ADMIN_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_TOKEN_SECRET
# Optional: set a pre-generated token instead of deriving it from ADMIN_PASSWORD.
ADMIN_TOKEN=
API_OUTBOX_ENABLED=true
API_OUTBOX_POLL_SECONDS=0.25
